{
  "name": "csir-tracker",
  "version": "2.0.0",
  "description": "CSIR-NET Chemistry Topic Tracker",
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder --win nsis",
    "android:sync": "node scripts/copy-web-assets.js && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:build": "npm run android:sync && cap build android"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "esbuild": "^0.25.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.csirtracker.desktop",
    "productName": "CSIR Tracker",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "CSIR-Tracker-Setup-${version}.${ext}"
    }
  }
}
